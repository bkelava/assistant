{
  "name": "kokelava-cloudflare",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages site for Kokelava with a document-generation application under /app.",
  "scripts": {
    "dev": "wrangler pages dev public --d1 CONTRACT_DB=contract-office-db",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create contract-office-db",
    "db:migrate": "wrangler d1 migrations apply contract-office-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply contract-office-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.14.0"
  }
}
